# spark-lab secrets — copy to `.env` (gitignored). `spark-lab init` creates this
# and generates the keys for you. NEVER commit a real `.env`.
#
# Values below are placeholders. Anything that looks like a real credential has
# been deliberately stripped; generate your own.

# --- LiteLLM gateway ---------------------------------------------------------
# 64-hex random values. `init` fills these via `openssl rand -hex 32`.
LITELLM_MASTER_KEY=sk-CHANGE_ME
LITELLM_SALT_KEY=sk-CHANGE_ME

# Postgres password for the LiteLLM database (user/db are set in config.yaml).
LITELLM_DB_PASSWORD=CHANGE_ME

# --- Monitoring --------------------------------------------------------------
# Grafana admin password.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- Model -------------------------------------------------------------------
# Hugging Face token. Required only for gated models; leave empty for open
# models. Read into the SGLang recipe at deploy time.
HF_TOKEN=

# --- Optional public exposure (Cloudflare Tunnel) ----------------------------
# Tunnel token from Cloudflare. Only used when network.cloudflare.enabled=true.
CF_TUNNEL_TOKEN=
