# Generated by spark-lab from config.yaml -- do not edit by hand.
# llama-swap model zoo (ADR-0010): requesting any model below starts its
# engine via sparkrun (`run --ensure`); idle models unload after their ttl
# and the next request starts (or wakes) the requested one. Edit the
# `swap:` blocks under `models:` in config.yaml, not this file.
healthCheckTimeout: {{ swap_healthcheck_timeout }}   # seconds: max zoo readiness + headroom
globalTTL: 0                                         # never unload by default; per-model ttl only
sendLoadingState: true                               # clients see "loading..." progress

models:
{% for e in swap_entries %}
  {{ e.model_id | tojson }}:
    # zoo model {{ e.alias }} -- recipe sparkrun/recipes/{{ e.alias }}.yaml,
    # engine {{ e.addr }}:{{ e.port }} (serves "{{ e.served }}"), ready <= {{ e.readiness }}s
    cmd: {{ e.cmd | tojson }}
    cmdStop: {{ e.cmd_stop | tojson }}
    proxy: http://127.0.0.1:{{ e.port }}
    checkEndpoint: /health
    useModelName: {{ e.served | tojson }}
    name: {{ e.name | tojson }}
    ttl: {{ e.ttl }}
    unloadTimeout: {{ e.unload_timeout }}
{% if e.aliases %}
    aliases:
{% for a in e.aliases %}
      - {{ a | tojson }}
{% endfor %}
{% endif %}
{% endfor %}
