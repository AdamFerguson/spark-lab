# Generated by spark-lab from config.yaml -- do not edit by hand.
# LiteLLM gateway + Postgres + Redis, and (optionally) a Prometheus/Grafana
# observability stack with GPU-aware exporters tuned for the GB10.
services:
  litellm:
    image: docker.litellm.ai/berriai/litellm:main-stable
    ports:
      - "{{ gateway_port }}:4000"
    env_file:
      - .env
    volumes:
      - ./config.yaml:/app/config.yaml
      - ./model_config.yaml:/app/model_config.yaml
    command: [ "--config", "/app/config.yaml" ]
{% if redis_enabled %}
    # Reach the SGLang server on the host (host.docker.internal = host-gateway).
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
{% else %}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      db:
        condition: service_healthy
{% endif %}

  db:
    image: {{ db_image }}
    environment:
      POSTGRES_USER: {{ db_user }}
      POSTGRES_PASSWORD: "{{ db_password }}"
      POSTGRES_DB: {{ db_name }}
    command: >
      sh -c "
      /usr/local/bin/docker-entrypoint.sh postgres &
      sleep 5;
      psql -U {{ db_user }} -d {{ db_name }} -c 'CREATE EXTENSION IF NOT EXISTS vector;';
      psql -U {{ db_user }} -d {{ db_name }} -c 'ALTER DATABASE {{ db_name }} REFRESH COLLATION VERSION;';
      wait
      "
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_user }} -d {{ db_name }}"]
      interval: 5s
      timeout: 5s
      retries: 10
    volumes:
      - postgres_data:/var/lib/postgresql/data
{% if redis_enabled %}

  redis:
    image: {{ redis_image }}
    ports:
      - "{{ redis_port }}:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 5s
    volumes:
      - redis_data:/data
{% endif %}
{% if monitoring_enabled %}

  prometheus:
    image: {{ prometheus_image }}
    volumes:
      - prometheus_data:/prometheus
      - ./prometheus.yml:/etc/prometheus/prometheus.yml
    ports:
      - "{{ prometheus_port }}:9090"
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time={{ prometheus_retention }}"
      - "--web.enable-lifecycle"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    restart: always

  grafana:
    image: {{ grafana_image }}
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning/datasources:/etc/grafana/provisioning/datasources
      - ./grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards
      - ./grafana/dashboards:/var/lib/grafana/dashboards
    ports:
      - "{{ grafana_port }}:3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
      - GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/sglang-dashboard.json
    depends_on:
      - prometheus
    restart: always

  node_exporter:
    image: prom/node-exporter:latest
    ports: ["9100:9100"]
    # hwmon/cpufreq disabled: the GPU /sys/class/hwmon node intermittently blocks
    # on GB10 and hangs scrapes; GPU metrics come from the DCGM exporter + sidecar.
    command:
      - "--path.rootfs=/host"
      - "--no-collector.hwmon"
      - "--no-collector.cpufreq"
      - "--collector.textfile.directory=/textfile"
    volumes: ["/:/host:ro,rslave", "gpu_textfile_data:/textfile:ro"]
    restart: always

  dcgm_exporter:
    image: utkuozdemir/nvidia_gpu_exporter:latest
    ports: ["9835:9835"]
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    restart: always

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest
    ports: ["8080:8080"]
    privileged: true
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /cgroup:/cgroup:ro
    restart: always

  gpu_textfile:
    image: ubuntu:24.04
    environment:
      - OUT_DIR=/var/lib/gpu-textfile
      - MEMINFO=/host/proc/meminfo
    volumes:
      - gpu_textfile_data:/var/lib/gpu-textfile
      - ./scripts/nvidia-gpu-textfile.sh:/opt/nvidia-gpu-textfile.sh:ro
      - /usr/bin/nvidia-smi:/usr/bin/nvidia-smi:ro
      - /:/host:ro
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]
    command: ["bash", "/opt/nvidia-gpu-textfile.sh"]
    restart: always

volumes:
  gpu_textfile_data:
  prometheus_data:
    name: litellm_prometheus_data
  postgres_data:
    name: litellm_postgres_data
{% if redis_enabled %}
  redis_data:
    name: litellm_redis_data
{% endif %}
  grafana_data:
    name: litellm_grafana_data
{% else %}
volumes:
  postgres_data:
    name: litellm_postgres_data
{% if redis_enabled %}
  redis_data:
    name: litellm_redis_data
{% endif %}
{% endif %}
