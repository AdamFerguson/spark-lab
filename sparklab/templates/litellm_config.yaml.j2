# Generated by spark-lab from config.yaml -- do not edit by hand.
include:
  - model_config.yaml

environment_variables:
  LITELLM_MASTER_KEY: "{{ master_key }}"
  LITELLM_SALT_KEY: "{{ salt_key }}"
  DATABASE_URL: "postgresql://{{ db_user }}:{{ db_password }}@db:5432/{{ db_name }}"
  STORE_MODEL_IN_DB: "True"

router_settings:
{% if redis_enabled %}
  # Route multi-instance metrics + global rate limits through Redis.
  redis_host: "redis"
  redis_port: {{ redis_port }}
{% endif %}

litellm_settings:
  # Overall prompt/response caching.
  cache: true
  drop_params: false
{% if redis_enabled %}
  enable_redis_auth_cache: true
  cache_params:
    type: "redis"
    host: "redis"
    port: {{ redis_port }}
{% endif %}
