# Generated by spark-lab from config.yaml -- do not edit by hand.
# Serves {{ hf_model }} via SGLang; exposes an OpenAI-compatible API on :{{ model_port }}.
model: {{ hf_model }}
runtime: sglang
min_nodes: {{ min_nodes }}
container: {{ model_image }}
executor: docker
executor_config:
  ipc: host
  shm_size: 32g
  # Required on Blackwell / GB10 for this SGLang build.
  # See https://github.com/radixark/miles/issues/364
  privileged: true
  cap_add:
    - SYS_PTRACE
  security_opt:
    - seccomp=unconfined
env:
  PYTORCH_CUDA_ALLOC_CONF: ""
  PYTORCH_ALLOC_CONF: ""
{% if hf_token %}
  # Gated model -- the token is injected at deploy time from your .env.
  HF_TOKEN: "{{ hf_token }}"
{% endif %}

metadata:
  description: "{{ install.name }} -- {{ hf_model }} served by SGLang"
  model_dtype: nvfp4

# Values available as {name} placeholders inside `command` below.
defaults:
  host: {{ model_host }}
  port: {{ model_port }}
{% for k, v in params.items() %}
  {{ k }}: {{ v }}
{% endfor %}

command: |
  sglang serve \
{% for f in extra_flags %}
    {{ f }} \
{% endfor %}
    --model-path {model} \
{% for k in params %}
    --{{ flag_map.get(k, k | replace('_', '-')) }} {{ '{' ~ k ~ '}' }} \
{% endfor %}
    --host {host} \
    --port {port}
