# Generated by spark-lab from config.yaml -- do not edit by hand.
# Serves {{ hf_model }} via the {{ runtime }} engine; exposes an OpenAI-compatible API on :{{ model_port }}.
model: {{ hf_model }}
{% if model_revision %}
# Pinned checkpoint revision (the recipe's `--revision` flag should match).
model_revision: {{ model_revision | tojson }}
{% endif %}
runtime: {{ runtime }}
min_nodes: {{ min_nodes }}
{% if layout_placements %}
# Placement pin: rendered by spark-lab from the config's hosts: list (the
# repo recipe this was rendered from is placement-agnostic). sparkrun honors
# an explicit layout verbatim, on every scheduler.
layout:
  placements:
{% for host, ranks in layout_placements %}
    - host: {{ host }}
      ranks: [{{ ranks | join(', ') }}]
{% endfor %}
{% endif %}
container: {{ model_image }}
executor: docker
{% if executor_overrides %}
executor_config:
{% if executor_is_base %}
  ipc: host
  shm_size: 32g
  # Required on Blackwell / GB10 for this SGLang build.
  # See https://github.com/radixark/miles/issues/364
  privileged: true
  cap_add:
    - SYS_PTRACE
  security_opt:
    - seccomp=unconfined
{% else %}
{{ executor_config_final | yaml_block }}
{% endif %}
{% else %}
executor_config:
  ipc: host
  shm_size: 32g
  # Required on Blackwell / GB10 for this SGLang build.
  # See https://github.com/radixark/miles/issues/364
  privileged: true
  cap_add:
    - SYS_PTRACE
  security_opt:
    - seccomp=unconfined
{% endif %}
env:
{% for line in env_lines %}
{{ line }}
{% endfor %}

metadata:
  description: "{{ install.name }} -- {{ hf_model }} served by {{ runtime }}"
  model_dtype: {{ model_metadata.get("model_dtype", "nvfp4") }}

# Values available as {name} placeholders inside `command` below.
defaults:
  host: {{ model_host }}
  port: {{ model_port }}
{% for k, v in params.items() %}
  {{ k }}: {{ v | yaml_scalar }}
{% endfor %}

command: |
{% if serve_command %}
  {{ serve_command }}
{% else %}
  sglang serve \
{% for f in extra_flags %}
    {{ f }} \
{% endfor %}
    --model-path {model} \
{% for k in params %}
    --{{ flag_map.get(k, k | replace('_', '-')) }} {{ '{' ~ k ~ '}' }} \
{% endfor %}
    --host {host} \
    --port {port}
{% endif %}
