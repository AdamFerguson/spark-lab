#!/usr/bin/env bash
# spark-lab — entrypoint. Manages a Python venv and execs the CLI.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
VENV=".venv"

have_deps() { "$VENV/bin/python" -c "import yaml, jinja2" >/dev/null 2>&1; }

setup_venv() {
  if command -v uv >/dev/null 2>&1; then
    [ -d "$VENV" ] || uv venv "$VENV" >/dev/null
    if ! have_deps; then
      echo "spark-lab: installing dependencies into $VENV (via uv)..." >&2
      uv pip install --quiet pyyaml jinja2
    fi
  else
    if [ ! -d "$VENV" ]; then
      echo "spark-lab: creating $VENV via python3 -m venv..." >&2
      python3 -m venv "$VENV"
    fi
    if ! have_deps; then
      echo "spark-lab: installing dependencies into $VENV (via pip)..." >&2
      "$VENV/bin/python" -m pip install --quiet --upgrade pip >/dev/null 2>&1 || true
      "$VENV/bin/python" -m pip install --quiet pyyaml jinja2
    fi
  fi
}

setup_venv
exec "$VENV/bin/python" -m lib.cli "$@"
