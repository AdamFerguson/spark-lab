# Generated by spark-lab from config.yaml -- do not edit by hand.
# Registers the self-hosted model with the LiteLLM gateway.
model_list:
  - model_name: {{ model_name }}
    litellm_params:
      # `custom_openai/` = LiteLLM's provider for self-hosted, OpenAI-compatible
      # endpoints (same handler as `openai/`, but labeled `custom_openai`).
      model: custom_openai/{{ hf_model }}
      api_base: {{ api_base }}
      api_key: "not-needed"
    model_info:
      id: "{{ hf_model }}"
      supports_vision: {{ 'true' if model_info.get('supports_vision', true) else 'false' }}
      # Hard limits validated at the gateway layer.
      max_input_tokens: {{ model_info.get('max_input_tokens', 32768) }}
      max_output_tokens: {{ model_info.get('max_output_tokens', 8192) }}
      # Per-token costs so LiteLLM spend tracking is meaningful (0 = free/self-hosted).
      input_cost_per_token: {{ model_info.get('input_cost_per_token', 0) }}
      output_cost_per_token: {{ model_info.get('output_cost_per_token', 0) }}
      cache_read_input_token_cost: {{ model_info.get('cache_read_input_token_cost', 0) }}
      supports_reasoning: {{ 'true' if model_info.get('supports_reasoning', true) else 'false' }}
{% for lvl in ['none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max'] %}
      supports_{{ lvl }}_reasoning_effort: {{ 'true' if lvl in model_info.get('supported_reasoning_efforts', []) else 'false' }}
{% endfor %}
      supported_openai_params: ["reasoning_effort", "max_tokens", "stream", "temperature"]
    # Native sampling defaults for good reasoning behavior.
    litellm_settings:
      temperature: {{ model_settings.temperature }}
      top_p: {{ model_settings.top_p }}
      top_k: {{ model_settings.top_k }}
