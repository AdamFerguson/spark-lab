# Generated by spark-lab from config.yaml -- do not edit by hand.
global:
  scrape_interval: 15s
  evaluation_interval: 30s
  external_labels:
    host: {{ instance }}
    hardware: gb10

scrape_configs:
  # Prometheus self-monitoring.
  - job_name: prometheus
    static_configs:
      - targets: [localhost:{{ prometheus_port }}]

  # LLM server -- SGLang on the host (started with --enable-metrics).
  # This SGLang build exports "sglang:<name>" (colon); the dashboards query
  # "sglang_<name>" (underscore) -- bridge the two at scrape time.
  - job_name: sglang
    scrape_interval: 5s
    metrics_path: /metrics
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: "sglang:(.*)"
        target_label: __name__
        replacement: "sglang_$1"
    static_configs:
      - targets: [host.docker.internal:{{ model_port }}]
        labels:
          instance: {{ instance }}

  # Host metrics. On GB10 unified memory, node_memory_* is your "VRAM" view.
  # Long timeout: crawling host /proc can exceed 10s on a loaded Spark.
  - job_name: node
    scrape_interval: 30s
    scrape_timeout: 25s
    static_configs:
      - targets: [node_exporter:9100]
        labels:
          instance: {{ instance }}

  # GPU clocks / temps / power / utilization.
  - job_name: dcgm
    scrape_interval: 5s
    static_configs:
      - targets: [dcgm_exporter:9835]
        labels:
          instance: {{ instance }}

  # Per-container CPU / RAM.
  - job_name: cadvisor
    static_configs:
      - targets: [cadvisor:8080]
        labels:
          instance: {{ instance }}
