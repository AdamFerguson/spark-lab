# Secrets + per-node config
.env
.env.*
config.yaml
config.yaml.*

# Local backup copies of anything (e.g. config.yaml.bak-v1-20260828) —
# a *.bak* file is by definition a local sink, never repo content
*.bak
*.bak.*

# Rendered deploy tree + state (generated by `spark-lab apply`)
deploy/
.sparklab-state/

# Generated recipe candidates (`spark-lab recipes convert`) -- review + promote manually
recipes/candidates/


# Managed Python venv
.venv/
.venv-test/
__pycache__/
*.pyc

# Test artifacts
.coverage
coverage.xml

# Build / packaging artifacts (pip install -e ., wheel builds)
build/
dist/
*.egg-info/

# OS / editor noise
.DS_Store
*.swp

# Remote operator lab configs (per-node config.yaml + .env — .env must never be committed)
labs/
