#!/usr/bin/env bash
#
# spark-lab pre-commit gate: no secrets, ever.
#
# Runs the full secret scan over tracked + staged files. If anything looks like
# a secret, the commit is BLOCKED. This is the mechanical guarantee that no
# secret reaches the repo, independent of whether a human or an agent is
# committing.
#
# Install (once per clone):  git config core.hooksPath .githooks
#
# Bypass ONLY after you have personally verified the repo is clean:
#   git commit --no-verify        # and note why in the commit message or PR

set -uo pipefail
repo="$(git rev-parse --show-toplevel)"

# --- ruff: lint + format the staged Python (CI enforces unconditionally) ----
mapfile -t pyfiles < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
if [ "${#pyfiles[@]}" -gt 0 ]; then
  if command -v uv >/dev/null 2>&1; then
    if ! (cd "$repo" && uv run --quiet ruff check --fix "${pyfiles[@]}"); then
      echo "" >&2
      echo "COMMIT BLOCKED — ruff lint findings that need human attention (above)." >&2
      echo "  Auto-fixables were applied; fix the rest and re-stage." >&2
      exit 1
    fi
    (cd "$repo" && uv run --quiet ruff format "${pyfiles[@]}" >/dev/null)
    git add -- "${pyfiles[@]}"   # keep formatting/lint fixes in the commit
  else
    echo "note: uv not found — skipped local ruff (CI will still enforce it)." >&2
  fi
fi

if ! bash "$repo/scripts/secret-scan.sh"; then
  echo "" >&2
  echo "COMMIT BLOCKED — spark-lab secret scan found potential secrets (above)." >&2
  echo "  Fix them (move values to the gitignored .env / config.yaml) and re-stage." >&2
  echo "  Or, after personally verifying cleanliness: git commit --no-verify" >&2
  exit 1
fi
